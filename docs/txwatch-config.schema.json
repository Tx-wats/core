{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/txwatch/txwatch/docs/txwatch-config.schema.json",
  "title": "AppConfig",
  "description": "Schema for txwatch TOML configuration files.",
  "type": "object",
  "required": ["contracts"],
  "properties": {
    "poll_interval_seconds": { "type": "integer", "minimum": 5, "maximum": 3600, "default": 10 },
    "cursor_file": { "type": ["string", "null"] },
    "http_pool_max_idle_per_host": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
    "http_tcp_keepalive_secs": { "type": "integer", "minimum": 0, "maximum": 7200, "default": 30 },
    "http_connection_verbose": { "type": ["boolean", "null"] },
    "max_pages_per_cycle": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000, "description": "Maximum Horizon pages (200 transactions each) fetched per contract in one poll cycle. Default: 10." },
    "max_contracts": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000, "description": "Maximum number of [[contracts]] entries. Default: 100." },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/WatchedContract" }, "minItems": 1 }
    "concurrency": { "type": ["integer", "null"], "minimum": 1, "maximum": 256, "description": "Maximum number of contracts polled concurrently in one cycle (used by watch and watch --once). Default: 10." },
    "contracts": { "type": "array", "items": { "$ref": "#/definitions/WatchedContract" }, "minItems": 1 }
  },
  "$defs": {
    "WatchedContract": {
      "type": "object", "required": ["label", "contract_id", "network", "rules"], "additionalProperties": false,
      "anyOf": [
        { "required": ["webhook_url"] },
        { "required": ["webhooks"], "properties": { "webhooks": { "minItems": 1 } } }
      ],
      "properties": {
        "label": { "type": "string", "maxLength": 128 },
        "contract_id": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "network": { "oneOf": [
          { "enum": ["mainnet", "testnet", "futurenet"] },
          { "type": "object", "required": ["horizon_url"], "additionalProperties": false,
            "properties": {
              "horizon_url": { "type": "string", "format": "uri" },
              "rpc_url": { "type": ["string", "null"], "format": "uri", "description": "Soroban RPC endpoint for this network." },
              "explorer_url": { "type": ["string", "null"], "format": "uri" },
              "passphrase": { "type": ["string", "null"] }
            } }
        ] },
        "soroban_rpc_url": { "type": ["string", "null"], "format": "uri", "description": "Soroban RPC endpoint used for contract event lookups." },
        "webhook_url": { "type": "string", "format": "uri", "description": "Shorthand for a single destination; described by the webhook_* fields." },
        "webhook_secret": { "type": ["string", "null"] },
        "webhook_format": { "$ref": "#/$defs/WebhookFormat" },
        "webhook_headers": { "$ref": "#/$defs/WebhookHeaders" },
        "webhook_routing_key": { "type": ["string", "null"], "description": "PagerDuty routing key; required when webhook_format = \"pagerduty\"." },
        "webhooks": { "type": "array", "items": { "$ref": "#/$defs/WebhookDestination" } },
        "poll_interval_seconds": { "type": ["integer", "null"], "minimum": 5, "maximum": 3600 },
        "batch_alerts": { "type": "boolean", "default": false, "description": "Deliver each poll cycle's alerts as one {\"alerts\": [...]} POST (split into batches of at most 50)." },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/AlertRule" }, "minItems": 1 }
      }
    },
    "WebhookFormat": { "enum": ["txwatch", "slack", "discord", "pagerduty", "teams"], "default": "txwatch" },
    "WebhookHeaders": {
      "type": "object",
      "description": "Extra HTTP headers; values support ${ENV_VAR}. Content-Type, Content-Length and X-TxWatch-* are reserved.",
      "propertyNames": { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "WebhookDestination": {
      "type": "object", "required": ["url"], "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "secret": { "type": ["string", "null"] },
        "format": { "$ref": "#/$defs/WebhookFormat" },
        "headers": { "$ref": "#/$defs/WebhookHeaders" },
        "routing_key": { "type": ["string", "null"], "description": "PagerDuty routing key; required when format = \"pagerduty\"." }
      },
      "if": { "properties": { "format": { "const": "pagerduty" } }, "required": ["format"] },
      "then": { "required": ["routing_key"] }
    },
    "AlertRule": {
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "AnyTransaction" } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "TransactionFailed" } } },
        { "type": "object", "required": ["type", "threshold_xlm"], "properties": { "type": { "const": "LargeTransfer" }, "threshold_xlm": { "type": "integer", "minimum": 1 }, "direction": { "$ref": "#/definitions/TransferDirection" } } },
        { "type": "object", "required": ["type", "function_name"], "properties": { "type": { "const": "FunctionCalled" }, "function_name": { "type": "string", "pattern": "^[a-zA-Z0-9_]{1,32}$" }, "args": { "type": "array", "items": { "$ref": "#/definitions/FunctionArg" }, "description": "Match invocation parameters by position; all entries must match." } } },
        { "type": "object", "required": ["type", "function_names"], "properties": { "type": { "const": "AdminFunctionCalled" }, "function_names": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9_]{1,32}$" } } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "HighFee" }, "threshold_stroops": { "type": "integer" }, "threshold_xlm": { "type": ["integer", "null"] } } },
        { "type": "object", "required": ["type", "rule", "count", "window_seconds"], "properties": { "type": { "const": "Rate" }, "rule": { "$ref": "#/definitions/AlertRule" }, "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "window_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 } }, "description": "Fires once per breach when the nested rule matches at least `count` times within a sliding `window_seconds` window." },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "Memo" }, "memo_type": { "enum": ["none", "text", "id", "hash", "return"] }, "equals": { "type": "string", "minLength": 1 }, "prefix": { "type": "string", "minLength": 1 } }, "oneOf": [ { "required": ["equals"] }, { "required": ["prefix"] } ], "description": "Matches the transaction memo; exactly one of `equals` or `prefix` is required." },
        { "type": "object", "required": ["type", "asset_code"], "properties": { "type": { "const": "AssetTransfer" }, "asset_code": { "type": "string", "pattern": "^[A-Z0-9]{1,12}$" }, "issuer": { "type": ["string", "null"] }, "min_amount": { "type": ["integer", "null"], "minimum": 0 } } },
        { "type": "object", "required": ["type", "function_name"], "properties": { "type": { "const": "FunctionArgumentMatched" }, "function_name": { "type": "string", "pattern": "^[a-zA-Z0-9_]{1,32}$" }, "argument_index": { "type": "integer", "minimum": 0 }, "argument_value": { "type": "string" } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "ContractEvent" }, "topic": { "type": ["string", "null"] } } },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "ContractUpgraded" } } },
        {
          "type": "object", "required": ["type", "topic"],
          "properties": {
            "type": { "const": "EventEmitted" },
            "topic": {
              "type": "array",
              "description": "Positional topic patterns. Each pattern matches any scalar ScVal; a bare value matches its symbol/string form, and an optional type prefix (e.g. \"address:G...\", \"u32:5\", \"symbol:transfer\", \"string:hello\", \"bool:true\") constrains the ScVal type.",
              "items": { "type": "string" }
            },
            "data": {
              "type": "array",
              "description": "Matchers over the decoded event data (JSON). All matchers must hold. i128/u128 values are compared as integers.",
              "items": { "$ref": "#/definitions/DataMatcher" }
            }
          }
        }
      ]
    },
    "FunctionArg": {
      "type": "object", "required": ["index", "eq"], "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "Zero-based position in the invocation parameters." },
        "eq": { "type": "string", "maxLength": 128, "description": "Expected value: address (G…/C…), symbol, integer, or string." }
      }
    },
    "TransferDirection": {
      "enum": ["in", "out", "any"],
      "default": "any",
      "description": "For LargeTransfer: only count balance changes where the watched contract is the recipient (\"in\"), the sender (\"out\"), or either (\"any\")."
    },
    "DataMatcher": {
      "type": "object", "required": ["path", "op", "value"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "description": "RFC 6901 JSON pointer into the decoded event data (e.g. \"/amount\", \"/0/to\"). Empty string refers to the whole data value." },
        "op": { "enum": ["eq", "gte", "lte"], "description": "Comparison operator. gte/lte require a numeric value." },
        "value": { "description": "Expected value: string, number, boolean or null. Numbers are compared as integers when the target is i128/u128." }
      }
    }
  }
}
